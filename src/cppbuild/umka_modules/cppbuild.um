type build_target* = struct {
    name:     str;
    kind:     str;
    srcs:     []str;
    deps:     []str;
    cxxflags: []str;
    cflags:   []str;
    ldflags:  []str;
}
type install_target* = struct {
    file:        str;
    install_dir: str;
    is_artifact: bool;
}
type result* = struct {
    build_targets:   []build_target;
    install_targets: []install_target;
}
type source_group* = struct {
    kind:  str;
    files: []str;
}
type target_options* = struct {
    name:    str;
    kind:    str;
    deps:    []str;
    sources: []source_group;
}
type install_source_group* = struct {
    dir:   str;
    files: []str;
}
type install_target_group* = struct {
    dir:     str;
    targets: []str;
}
type install_options* = struct {
    targets: []install_target_group;
    sources: []install_source_group;
}
var build_config*: result
fn target*(opts: target_options) {
    for _, sg in opts.sources {
        step_name := opts.name + "_" + sg.kind
        var filtered_deps: []str
        for _, dep in opts.deps {
            filtered_deps = append(filtered_deps, dep)
        }
        build_config.build_targets = append(build_config.build_targets, build_target{
            name:  step_name,
            kind:  sg.kind,
            deps:  filtered_deps,
            srcs:  sg.files
        })
        opts.deps = append(opts.deps, step_name)
    }
    if opts.kind == "exe" || opts.kind == "shared" || opts.kind == "static" {
        build_config.build_targets = append(build_config.build_targets, build_target{
            name:  opts.name,
            kind:  opts.kind,
            deps:  opts.deps,
            srcs:  []str{}
        })
    }
}
fn install*(opts: install_options) {
    for _, tg in opts.targets {
        for _, name in tg.targets {
            for _, t in build_config.build_targets {
                if t.name == name {
                    if t.kind == "exe" {
                        build_config.install_targets = append(build_config.install_targets, install_target{file: name + ".elf", install_dir: tg.dir, is_artifact: true})
                    } else if t.kind == "shared" {
                        build_config.install_targets = append(build_config.install_targets, install_target{file: "lib" + name + ".so", install_dir: tg.dir, is_artifact: true})
                    } else if t.kind == "static" {
                        build_config.install_targets = append(build_config.install_targets, install_target{file: "lib" + name + ".a", install_dir: tg.dir, is_artifact: true})
                    }
                    break
                }
            }
        }
    }
    for _, sg in opts.sources {
        for _, file in sg.files {
            build_config.install_targets = append(build_config.install_targets, install_target{file: file, install_dir: sg.dir, is_artifact: false})
        }
    }
}
