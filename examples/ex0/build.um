import (
    "std.um"
    "cppbuild.um"
)

fn configure*(): []cppbuild::build_target {
    cppbuild::target("target0", "exe", []str{})
        cppbuild::add_sources("named_module", []str{"m4.c++", "m3.cppm", "m2.cc", "m1.cpp"})
        cppbuild::add_sources("translation_unit", []str{"app0.cpp"})
    cppbuild::end()

    cppbuild::target("target1", "exe", []str{})
        cppbuild::add_sources("header_unit", []str{"h1.hpp", "h2.h", "h3.hh", "h4.h++"})
        cppbuild::add_sources("translation_unit", []str{"h1.cpp", "h2.cpp", "h3.cpp", "h4.cpp", "app1.cpp"})
    cppbuild::end()

    cppbuild::target("target2", "exe", []str{})
        cppbuild::add_sources("translation_unit", []str{"tu0.c", "tu1.cpp"})
    cppbuild::end()

    cppbuild::target("myshared", "shared", []str{})
        cppbuild::add_sources("translation_unit", []str{"lib0.cpp"})
    cppbuild::end()

    cppbuild::target("mystatic", "static", []str{})
        cppbuild::add_sources("translation_unit", []str{"lib1.cpp"})
    cppbuild::end()

    return cppbuild::build_targets
}
