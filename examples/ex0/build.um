import (
    "std.um"
    "cppbuild.um"
)
fn configure*(): cppbuild::result {
    cppbuild::target({
        name:  "target0",
        kind:  "exe",
        sources: {
            {kind: "named_module",     files: {"m4.c++", "m3.cppm", "m2.cc", "m1.cpp"}},
            {kind: "translation_unit", files: {"app0.cpp"}}
        }
    })
    cppbuild::target({
        name:  "target1",
        kind:  "exe",
        sources: {
            {kind: "header_unit",      files: {"h1.hpp", "h2.h", "h3.hh", "h4.h++"}},
            {kind: "translation_unit", files: {"h1.cpp", "h2.cpp", "h3.cpp", "h4.cpp", "app1.cpp"}}
        }
    })
    cppbuild::target({
        name:  "target2",
        kind:  "exe",
        sources: {
            {kind: "translation_unit", files: {"tu0.c", "tu1.cpp"}}
        }
    })
    cppbuild::target({
        name:  "myshared",
        kind:  "shared",
        sources: {
            {kind: "translation_unit", files: {"lib0.cpp"}}
        }
    })
    cppbuild::target({
        name:  "mystatic",
        kind:  "static",
        sources: {
            {kind: "translation_unit", files: {"lib1.cpp"}}
        }
    })
    cppbuild::install({
        targets: {{dir: "lib",     targets: {"myshared", "mystatic"}}},
        sources: {{dir: "include", files:   {"h1.cpp", "h2.h"}}}
    })
    return cppbuild::build_config
}
