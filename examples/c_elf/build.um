import (
    "std.um"
    "cppbuild.um"
)
fn configure*(): cppbuild::results {
    cppbuild::add_build_target({
        name: "hello",
        srcs: {
            {kind: "translation_unit", srcs: {"main.c"}}
        },
        gen_groups: {},
        deps: {},
        cxxflags: {public: {}, private: {}},
        cflags: {public: {}, private: {}}
    })
    cppbuild::add_link_target({
        name: "hello",
        kind: "executable",
        deps: {"hello"}
    })
    return cppbuild::build_config
}
