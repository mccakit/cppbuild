import (
    "std.um"
    "cppbuild.um"
)
fn configure*(): cppbuild::results {
    cppbuild::add_build_target({
        name: "diamond",
        srcs: {},
        gen_groups: {
            {
                command: {
                    "python3",
                    cppbuild::script_dir + "/codegen.py",
                    "--inputs",
                    cppbuild::script_dir + "/in0.txt",
                    cppbuild::script_dir + "/in1.txt",
                    "--outputs",
                    cppbuild::build_dir + "/d.h",
                    cppbuild::build_dir + "/d.c",
                    cppbuild::build_dir + "/c.h",
                    cppbuild::build_dir + "/c.c",
                    cppbuild::build_dir + "/b.h",
                    cppbuild::build_dir + "/b.c",
                    cppbuild::build_dir + "/a.h",
                    cppbuild::build_dir + "/a.c"
                },
                inputs: {"in0.txt", "in1.txt"},
                outputs: {
                    {path: "d.c", kind: "translation_unit"},
                    {path: "c.c", kind: "translation_unit"},
                    {path: "b.c", kind: "translation_unit"},
                    {path: "a.c", kind: "translation_unit"}
                }
            }
        },
        deps: {},
        cxxflags: {public: {}, private: {}},
        cflags: {public: {"-I" + cppbuild::build_dir}, private: {}}
    })
    return cppbuild::build_config
}
